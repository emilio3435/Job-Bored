{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/job-bored/command-center/schemas/pipeline-update-request.v2.schema.json",
  "title": "Command Center pipeline update (POST body), v2",
  "description": "Sent by an external agent to advance an existing Pipeline row from inbound signals (e.g. recruiter email). schemaVersion 2: stage Applied requires appliedDate and source; dates are YYYY-MM-DD. The worker answers 409 with code header_mismatch when the Pipeline header drifted and ambiguous_match when the job matches more than one row. schemaVersion 1 bodies (schemas/pipeline-update-request.v1.schema.json) are still accepted.",
  "type": "object",
  "additionalProperties": true,
  "required": ["event", "schemaVersion", "sheetId", "job", "fields"],
  "properties": {
    "event": { "type": "string", "const": "command-center.pipeline-update" },
    "schemaVersion": { "type": "integer", "const": 2 },
    "sheetId": { "type": "string", "minLength": 10 },
    "job": {
      "type": "object",
      "additionalProperties": true,
      "description": "Row identity. Provide url, or both company and title. More than one matching row is refused (409 ambiguous_match).",
      "properties": {
        "url": { "type": "string" },
        "company": { "type": "string" },
        "title": { "type": "string" }
      },
      "anyOf": [
        { "required": ["url"], "properties": { "url": { "type": "string", "minLength": 1 } } },
        { "required": ["company", "title"], "properties": { "company": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } } }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stage": { "type": "string", "enum": ["New", "Researching", "Applied", "Phone Screen", "Interviewing", "Offer", "Rejected", "Passed", "Expired"] },
        "contact": { "type": "string" },
        "note": { "type": "string" },
        "lastContact": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "appliedDate": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "source": { "type": "string", "description": "Where the application went in (e.g. Company portal, Referral). Written into the Applied audit note." },
        "didTheyReply": { "type": "string", "enum": ["Yes", "No", "Unknown"] }
      },
      "if": { "required": ["stage"], "properties": { "stage": { "const": "Applied" } } },
      "then": {
        "required": ["appliedDate", "source"],
        "properties": { "appliedDate": { "minLength": 10 }, "source": { "type": "string", "pattern": "\\S" } }
      }
    }
  }
}
