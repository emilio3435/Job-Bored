{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emilio3435/Job-Bored/schemas/materials-draft.v1.schema.json",
  "title": "materials.draft.v1",
  "description": "Plain-string draft slots from the Materials v3 draft stage: a statement, one string per featured bullet keyed by claim id, earlier lines, and four letter paragraphs. No markup in any field; emphasis is the metric tagger's job.",
  "type": "object",
  "required": ["contract", "jdHash", "ledgerHash", "statement", "bullets", "letter"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "materials.draft.v1" },
    "jdHash": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" },
    "ledgerHash": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" },
    "statement": { "type": "string" },
    "bullets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claimId", "text"],
        "additionalProperties": false,
        "properties": {
          "claimId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "earlier": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "claimId": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "letter": {
      "type": "object",
      "required": ["thesis", "analyticsProof", "aiOpsProof", "nextStep"],
      "additionalProperties": false,
      "properties": {
        "thesis": { "type": "string" },
        "analyticsProof": { "type": "string" },
        "aiOpsProof": { "type": "string" },
        "nextStep": { "type": "string" }
      }
    }
  }
}
