{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emilio3435/Job-Bored/schemas/materials-run.v1.schema.json",
  "title": "materials.run.v1",
  "description": "Append-only stage ledger for one materials run. The dossier polls this for stage-level progress; pending.json is written beside it as a UI compatibility shim. Never contains credentials.",
  "type": "object",
  "required": ["contract", "runId", "slug", "feature", "requestedAt", "executor", "stages"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "materials.run.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "feature": { "enum": ["resume", "cover_letter", "both"] },
    "requestedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "executor": { "enum": ["local-inprocess", "hermes-cli", "webhook"] },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "requestedModel": { "type": "string" },
        "resolvedModel": { "type": "string" }
      }
    },
    "note": { "type": "string" },
    "budget": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max": { "type": "integer" },
          "used": { "type": "integer" }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "status"],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "enum": [
              "intake",
              "jd.resolve",
              "jd.gate",
              "jd.extract",
              "claims.load",
              "claims.score",
              "claims.select",
              "outline",
              "draft",
              "delint",
              "tag-metrics",
              "fit",
              "render",
              "qa",
              "publish"
            ]
          },
          "status": { "enum": ["ok", "skipped", "review", "failed"] },
          "ms": { "type": "integer", "minimum": 0 },
          "llm": { "type": "boolean" },
          "tokensOut": { "type": "integer", "minimum": 0 },
          "out": { "type": "array", "items": { "type": "string" } },
          "detail": { "type": "string" }
        }
      }
    },
    "repairs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["code", "reenteredAt"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "reenteredAt": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string" },
          "pages": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
