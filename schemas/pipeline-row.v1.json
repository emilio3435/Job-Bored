{
  "$id": "https://github.com/job-bored/command-center/schemas/pipeline-row.v1.json",
  "title": "Command Center Pipeline row (Interface A)",
  "description": "Descriptor for the Pipeline sheet tab: column letters, header labels, and constrained values where the UI enforces enums. schemaVersion 1. Authoritative UI enums: app.js renderCardActions (status), priority order objects, response select.",
  "schemaVersion": 1,
  "tabName": "Pipeline",
  "discoveryMergeSemantics": {
    "overwrite": "Discovery owns the cell: a re-discovered non-empty value replaces it. Fit Assessment is also cleared when a new Fit Score has no assessment. A non-LLM score replaces a non-empty Fit Score only when its existing Scorer (AA) is explicitly 'heuristic'; blank or unknown provenance is protected.",
    "lockable": "Discovery replaces the cell unless the row's Edit Lock (Y) names the field.",
    "fillIfEmpty": "Discovery writes the cell only while it is empty; a user's value is kept.",
    "preserve": "Discovery preserves the cell on a re-discovered row; Notes may gain a stamped reopening notice when an Expired posting is seen again."
  },
  "headerRow": [
    "Date Found",
    "Title",
    "Company",
    "Location",
    "Link",
    "Source",
    "Salary",
    "Fit Score",
    "Priority",
    "Tags",
    "Fit Assessment",
    "Contact",
    "Status",
    "Applied Date",
    "Notes",
    "Follow-up Date",
    "Talking Points",
    "Last contact",
    "Did they reply?",
    "Logo URL",
    "Search Match",
    "Favorite",
    "Dismissed At",
    "Approval Status",
    "Edit Lock",
    "Work Mode",
    "Scorer",
    "Last Seen",
    "Possible Duplicate"
  ],
  "columns": [
    {
      "id": "dateFound",
      "letter": "A",
      "headerLabel": "Date Found",
      "type": "date",
      "sheetIndex": 0,
      "discoveryMerge": "fillIfEmpty"
    },
    {
      "id": "title",
      "letter": "B",
      "headerLabel": "Title",
      "type": "string",
      "sheetIndex": 1,
      "discoveryMerge": "lockable"
    },
    {
      "id": "company",
      "letter": "C",
      "headerLabel": "Company",
      "type": "string",
      "sheetIndex": 2,
      "discoveryMerge": "lockable"
    },
    {
      "id": "location",
      "letter": "D",
      "headerLabel": "Location",
      "type": "string",
      "sheetIndex": 3,
      "discoveryMerge": "lockable"
    },
    {
      "id": "link",
      "letter": "E",
      "headerLabel": "Link",
      "type": "string",
      "sheetIndex": 4,
      "discoveryMerge": "overwrite"
    },
    {
      "id": "source",
      "letter": "F",
      "headerLabel": "Source",
      "type": "string",
      "sheetIndex": 5,
      "discoveryMerge": "fillIfEmpty"
    },
    {
      "id": "salary",
      "letter": "G",
      "headerLabel": "Salary",
      "type": "string",
      "sheetIndex": 6,
      "discoveryMerge": "lockable"
    },
    {
      "id": "fitScore",
      "letter": "H",
      "headerLabel": "Fit Score",
      "type": "number",
      "sheetIndex": 7,
      "discoveryMerge": "overwrite"
    },
    {
      "id": "priority",
      "letter": "I",
      "headerLabel": "Priority",
      "type": "string",
      "sheetIndex": 8,
      "discoveryMerge": "fillIfEmpty",
      "enum": ["🔥", "⚡", "—", "↓"],
      "emptyAllowed": true
    },
    {
      "id": "tags",
      "letter": "J",
      "headerLabel": "Tags",
      "type": "string",
      "sheetIndex": 9,
      "discoveryMerge": "fillIfEmpty"
    },
    {
      "id": "fitAssessment",
      "letter": "K",
      "headerLabel": "Fit Assessment",
      "type": "string",
      "sheetIndex": 10,
      "discoveryMerge": "overwrite"
    },
    {
      "id": "contact",
      "letter": "L",
      "headerLabel": "Contact",
      "type": "string",
      "sheetIndex": 11,
      "discoveryMerge": "fillIfEmpty"
    },
    {
      "id": "status",
      "letter": "M",
      "headerLabel": "Status",
      "type": "string",
      "sheetIndex": 12,
      "discoveryMerge": "fillIfEmpty",
      "enum": [
        "New",
        "Researching",
        "Applied",
        "Phone Screen",
        "Interviewing",
        "Offer",
        "Rejected",
        "Passed",
        "Expired"
      ],
      "emptyAllowed": true
    },
    {
      "id": "appliedDate",
      "letter": "N",
      "headerLabel": "Applied Date",
      "type": "date",
      "sheetIndex": 13,
      "discoveryMerge": "preserve"
    },
    {
      "id": "notes",
      "letter": "O",
      "headerLabel": "Notes",
      "type": "string",
      "sheetIndex": 14,
      "discoveryMerge": "preserve"
    },
    {
      "id": "followUpDate",
      "letter": "P",
      "headerLabel": "Follow-up Date",
      "type": "date",
      "sheetIndex": 15,
      "discoveryMerge": "preserve"
    },
    {
      "id": "talkingPoints",
      "letter": "Q",
      "headerLabel": "Talking Points",
      "type": "string",
      "sheetIndex": 16,
      "discoveryMerge": "fillIfEmpty"
    },
    {
      "id": "lastHeardFrom",
      "letter": "R",
      "headerLabel": "Last contact",
      "type": "string",
      "sheetIndex": 17,
      "discoveryMerge": "preserve",
      "optionalColumn": true
    },
    {
      "id": "responseFlag",
      "letter": "S",
      "headerLabel": "Did they reply?",
      "type": "string",
      "sheetIndex": 18,
      "discoveryMerge": "preserve",
      "enum": ["Yes", "No", "Unknown"],
      "emptyAllowed": true,
      "optionalColumn": true
    },
    {
      "id": "logoUrl",
      "letter": "T",
      "headerLabel": "Logo URL",
      "type": "string",
      "sheetIndex": 19,
      "discoveryMerge": "overwrite",
      "optionalColumn": true
    },
    {
      "id": "matchScore",
      "letter": "U",
      "headerLabel": "Search Match",
      "type": "number",
      "sheetIndex": 20,
      "discoveryMerge": "overwrite",
      "optionalColumn": true
    },
    {
      "id": "favorite",
      "letter": "V",
      "headerLabel": "Favorite",
      "type": "string",
      "sheetIndex": 21,
      "discoveryMerge": "fillIfEmpty",
      "optionalColumn": true
    },
    {
      "id": "dismissedAt",
      "letter": "W",
      "headerLabel": "Dismissed At",
      "type": "string",
      "sheetIndex": 22,
      "discoveryMerge": "fillIfEmpty",
      "optionalColumn": true
    },
    {
      "id": "approvalStatus",
      "letter": "X",
      "headerLabel": "Approval Status",
      "type": "string",
      "sheetIndex": 23,
      "discoveryMerge": "fillIfEmpty",
      "description": "Gate 1 approval marker for the JHOS apply flow. Set to 'Approved' by Emilio in the Pipeline tab before an agent may advance an apply card. Workers read this field to determine whether submission is permitted.",
      "optionalColumn": true
    },
    {
      "id": "editLock",
      "letter": "Y",
      "headerLabel": "Edit Lock",
      "type": "string",
      "sheetIndex": 24,
      "discoveryMerge": "preserve",
      "description": "Comma-separated, de-duplicated list of user-locked field ids drawn from {title,company,location,salary}, e.g. 'title,salary'. Written by the dashboard when a user edits an identity field. mergeExistingRow preserves the locked columns (title:1, company:2, location:3, salary:6) against re-discovery for that row only; untouched/locked-elsewhere identity fields keep improving. Empty/absent => no lock => byte-identical pre-change discovery behavior.",
      "optionalColumn": true
    },
    {
      "id": "workMode",
      "letter": "Z",
      "headerLabel": "Work Mode",
      "type": "string",
      "sheetIndex": 25,
      "discoveryMerge": "fillIfEmpty",
      "enum": ["remote", "hybrid", "onsite"],
      "optionalColumn": true
    },
    {
      "id": "scorer",
      "letter": "AA",
      "headerLabel": "Scorer",
      "type": "string",
      "sheetIndex": 26,
      "discoveryMerge": "overwrite",
      "description": "Which scorer produced Fit Score (H): 'llm:<model>' for an LLM score, 'heuristic' for the keyword fallback, 'prefilter' for a rescore hard-constraint miss. Written with H in the same pass. A non-LLM score replaces a non-empty H only when the existing Scorer is explicitly 'heuristic'. Blank or unknown provenance is protected, keeping H, K and AA together.",
      "optionalColumn": true
    },
    {
      "id": "lastSeen",
      "letter": "AB",
      "headerLabel": "Last Seen",
      "type": "date",
      "sheetIndex": 27,
      "discoveryMerge": "overwrite",
      "description": "The last day discovery found this posting live (YYYY-MM-DD, the worker's local day). An Expired row seen after its expiry is offered for reopening in Review.",
      "optionalColumn": true
    },
    {
      "id": "possibleDuplicate",
      "letter": "AC",
      "headerLabel": "Possible Duplicate",
      "type": "string",
      "description": "Set when discovery appended this row although it looks like another row (same company, title and location) without a matching URL or job id: holds that row's Link. Clear it to dismiss the flag; re-discovery never changes it.",
      "sheetIndex": 28,
      "discoveryMerge": "preserve",
      "optionalColumn": true
    }
  ]
}
