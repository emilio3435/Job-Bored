{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/job-bored/command-center/schemas/run-status.v1.schema.json",
  "title": "Discovery run status (GET /runs/:runId)",
  "description": "The body of a 200 from the Browser Use worker's GET /runs/:runId, and the `run` object of a POST /runs/:runId/cancel answer. Async /webhook and /ingest-url acks point at it through `statusPath`. `write_failed` is terminal for polling but can change after POST /runs/:runId/retry-write. Readers must ignore fields they do not know.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "runId",
    "status",
    "terminal",
    "message",
    "trigger",
    "request",
    "acceptedAt",
    "updatedAt",
    "warnings",
    "sources"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "Present on the HTTP body (GET /runs/:runId); absent on the nested `run` object."
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "completed",
        "partial",
        "empty",
        "failed",
        "write_failed"
      ]
    },
    "terminal": {
      "type": "boolean",
      "description": "True for completed, partial, empty, failed and write_failed. A write_failed run can transition after an explicit write retry."
    },
    "message": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sheetId",
        "variationKey",
        "requestedAt"
      ],
      "properties": {
        "sheetId": {
          "type": "string"
        },
        "variationKey": {
          "type": "string",
          "description": "`ingest_url` for an async /ingest-url run."
        },
        "requestedAt": {
          "type": "string"
        }
      }
    },
    "acceptedAt": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "error": {
      "type": "string",
      "description": "Why a failed run failed. A cancelled run says `Cancelled by user.`; a worker restart says the run was interrupted."
    },
    "progress": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "phase",
        "sequence",
        "checkpointedAt"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointedAt": {
          "type": "string"
        },
        "heartbeatAt": {
          "type": "string",
          "description": "Last persisted observation while the run was active; compare observed sequence changes on the reader's clock."
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "companiesTotal": {
              "type": "integer",
              "minimum": 0
            },
            "companiesDone": {
              "type": "integer",
              "minimum": 0
            },
            "boardsDetected": {
              "type": "integer",
              "minimum": 0
            },
            "listingsSeen": {
              "type": "integer",
              "minimum": 0
            },
            "listingsProcessed": {
              "type": "integer",
              "minimum": 0
            },
            "leadsQualified": {
              "type": "integer",
              "minimum": 0
            },
            "matcherCalls": {
              "type": "integer",
              "minimum": 0
            },
            "queriesTotal": {
              "type": "integer",
              "minimum": 0
            },
            "queriesDone": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "label"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "company",
                "source",
                "query"
              ]
            },
            "label": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "done",
                  "skipped"
                ]
              },
              "done": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true
    },
    "writeResult": {
      "type": "object",
      "additionalProperties": true
    },
    "ingestResult": {
      "$ref": "ingest-url-response.v1.schema.json",
      "description": "Async /ingest-url only: the final ingest answer."
    },
    "ultraPlanTuning": {
      "type": "object"
    },
    "groundedSearchTuning": {
      "type": "object"
    },
    "profileSnapshot": {
      "type": "object"
    },
    "searchPlan": {
      "type": "object"
    },
    "runStats": {
      "type": "object",
      "description": "Measured terminal discovery statistics. Absent on old or non-terminal runs. Every metric key is optional: absence means not measured, never zero.",
      "additionalProperties": true,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "funnel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "companiesSearched": {
              "type": "integer",
              "minimum": 0
            },
            "boardsDetected": {
              "type": "integer",
              "minimum": 0
            },
            "queriesRun": {
              "type": "integer",
              "minimum": 0
            },
            "listingsSeen": {
              "type": "integer",
              "minimum": 0
            },
            "listingsProcessed": {
              "type": "integer",
              "minimum": 0
            },
            "duplicatesInRun": {
              "type": "integer",
              "minimum": 0
            },
            "duplicatesVsSheet": {
              "type": "integer",
              "minimum": 0
            },
            "rejected": {
              "type": "integer",
              "minimum": 0
            },
            "candidates": {
              "type": "integer",
              "minimum": 0
            },
            "written": {
              "type": "integer",
              "minimum": 0
            },
            "updated": {
              "type": "integer",
              "minimum": 0
            },
            "rejectedTopReasons": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason",
                  "count"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scored",
            "avg",
            "median",
            "min",
            "max",
            "scale",
            "histogram"
          ],
          "properties": {
            "scored": {
              "type": "integer",
              "minimum": 1
            },
            "avg": {
              "type": "number",
              "minimum": 0
            },
            "median": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "scale": {
              "const": 10
            },
            "histogram": {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Counts for rounded score buckets 0 through 10."
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "searched": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "companies": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "boards": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "queries": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "seen": {
                "type": "integer",
                "minimum": 0
              },
              "accepted": {
                "type": "integer",
                "minimum": 0
              },
              "rejected": {
                "type": "integer",
                "minimum": 0
              },
              "duplicates": {
                "type": "integer",
                "minimum": 0
              },
              "timeouts": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "type": "string",
                "enum": [
                  "done",
                  "partial",
                  "failed",
                  "skipped"
                ]
              }
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "startedAt"
            ],
            "properties": {
              "phase": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "matcherCalls": {
          "type": "integer",
          "minimum": 0
        },
        "searched": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "companies",
            "queries",
            "truncated"
          ],
          "properties": {
            "companies": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "queries": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
