# Render builds from the checkout root, so copy assets directly at build time.
FROM node:24-alpine
RUN apk add --no-cache python3 chromium
WORKDIR /app/server
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev
COPY server/ ./
COPY schemas/ /app/schemas/
COPY templates/materials/ /app/templates/materials/
COPY vendor/fonts/ /app/vendor/fonts/
ENV LISTEN_HOST=0.0.0.0
ENV PORT=3847
ENV JOBBORED_CHROMIUM_PATH=/usr/bin/chromium-browser
EXPOSE 3847
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3847)+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "index.mjs"]
