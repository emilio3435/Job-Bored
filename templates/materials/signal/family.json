{
  "id": "signal",
  "label": "Signal",
  "description": "The default. A Volt name band with a graduated scale, a strip of verified figures, and a logo-labelled log.",
  "version": "1.4",
  "documents": { "resume": "resume.html", "coverLetter": "cover-letter.html" },
  "stylesheet": "signal.css",
  "fonts": ["Marcellus", "Geist", "Geist Mono", "Caveat"],
  "accents": ["volt", "ink"],
  "densities": ["standard"],
  "headers": ["paper", "ink"],
  "defaultHeader": "paper",
  "nameDots": { "metrics": "marcellus-400-normal", "letterSpacingEm": -0.005, "lineHeight": 1.1 },
  "nameFit": {
    "resume": { "metrics": "marcellus-400-normal", "maxPt": 34, "minPt": 20, "boxPt": 511.2, "fullRowPt": 532.8, "letterSpacingEm": -0.005, "reserve": { "from": "contact", "fontPt": 7.6, "advanceEm": 0.6, "extraPt": 28 } },
    "coverLetter": { "metrics": "marcellus-400-normal", "maxPt": 34, "minPt": 20, "boxPt": 511.2, "fullRowPt": 532.8, "letterSpacingEm": -0.005, "reserve": { "from": "contact", "fontPt": 7.6, "advanceEm": 0.6, "extraPt": 28 } }
  },
  "logos": {
    "opticalSizesIn": { "mark": 0.34, "wordmark": 0.2, "lockup": 0.28 },
    "hideNameBesideWordmark": false,
    "monogramFallback": true
  },
  "fit": {
    "bottomMarginIn": 0.3,
    "resumeLadderTail": ["drop_section:ventures", "drop_toolkit_group:Ramping", "drop_readouts"],
    "letterLadder": ["css:tight-1", "css:tight-2", "drop_letter_readouts", "css:tight-3"]
  },
  "budgets": { "visibleWords": [340, 560], "featuredEmployers": 3, "bulletsPerFeatured": [2, 5], "letterWords": [120, 200] },
  "reads": ["logo", "readouts", "toolkit", "credentials", "ventures", "letterReadouts"],
  "signatureMoves": [
    "A narrow Volt band with a white graduated scale carries only the name, the target title and the contact details.",
    "A readout strip of verified figures in Geist Mono, under Volt channel brackets labelled by employer.",
    "A logo-labelled log in one reading column, with dates in a 1in gutter and metric-led bullets."
  ]
}
