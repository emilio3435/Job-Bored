    "chatId": null,
    "threadId": null,
    "approverUserIds": [],
    "requireReplyToRequest": true,
    "cancelOnOtherReply": true,
    "confirmationPrefix": "YES SUBMIT",
    "timeoutSeconds": 600,
    "pollIntervalSeconds": 10
  },
  "interest": {
    "id": "interest",
    "purpose": "research-interest-prompt",
    "channel": "telegram",
    "chatId": null,
    "threadId": null,
    "setsStatus": "Researching"
  }
