{
  "templateVersion": 1,
  "name": "JobBored Cloudflare discovery relay",
  "workerName": "jobbored-discovery-relay",
  "entrypoint": "src/worker.js",
  "compatibilityDate": "2026-05-01",
  "routes": ["/discovery", "/runs/:runId", "/health"],
  "deployCommand": "wrangler deploy --var DISCOVERY_TARGET:https://your-ngrok-url.ngrok-free.app --var SHARED_SECRET:replace-with-a-long-random-value --var ALLOWED_ORIGINS:https://your-dashboard.example",
  "vars": [
    {
      "name": "DISCOVERY_TARGET",
      "required": true,
      "source": "wrangler --var at deploy time",
      "description": "Base HTTPS URL for the user's current local discovery tunnel."
    },
    {
      "name": "SHARED_SECRET",
      "required": true,
      "source": "wrangler --var at deploy time",
      "description": "Bearer token every relayed request must send. Without it the relay answers 401 (fails closed)."
    },
    {
      "name": "ALLOWED_ORIGINS",
      "required": false,
      "source": "wrangler --var at deploy time",
      "description": "Comma-separated browser origins (for example https://your-dashboard.example) allowed to call the relay. Any other browser origin gets 403; there is no wildcard."
    }
  ],
  "upstreamRoutes": [
    {
      "method": "POST",
      "path": "/discovery",
      "forwardsTo": "${DISCOVERY_TARGET}/discovery"
    },
    {
      "method": "GET",
      "path": "/runs/:runId",
      "forwardsTo": "${DISCOVERY_TARGET}/runs/:runId"
    },
    {
      "method": "GET",
      "path": "/health",
      "forwardsTo": "local relay health response"
    }
  ],
  "auth": {
    "type": "required_bearer",
    "envVar": "SHARED_SECRET"
  },
  "privacy": {
    "requestBodiesLogged": false
  }
}
